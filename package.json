{
  "name": "gravitybox",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "GravityBox Windows: Antigravity Companion Desktop Edition (based on Enzoo404/gravitybox)",
  "license": "MIT",
  "author": "Enzoo404 (Original macOS) / Citrus0914 (Windows Port)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citrus0914/gravitybox-windows.git"
  },
  "bugs": {
    "url": "https://github.com/Citrus0914/gravitybox-windows/issues"
  },
  "homepage": "https://github.com/Citrus0914/gravitybox-windows#readme",
  "scripts": {
    "build": "node tools/clean-dist.mjs && tsc && node tools/copy-runtime.mjs",
    "test": "npm run build && node tools/sync-pricing-feed.mjs && node tools/run-tests.mjs",
    "test:unit": "npm run build && node tools/run-tests.mjs",
    "test:fast": "npm run build && node tools/run-tests.mjs --fast",
    "test:browser": "npm run build && node test/browser.mjs",
    "check:privacy": "node tools/check-privacy.mjs",
    "start": "node dist/main.js",
    "verify:win": "node tools/verify-win.mjs",
    "desktop:build": "node tools/build-desktop.mjs",
    "package:win": "node tools/package-win.mjs",
    "bench:usage": "npm run build && node tools/benchmark-usage.mjs",
    "icons:gen": "node tools/generate-icons.mjs",
    "doctor": "node tools/doctor.mjs",
    "setup:dev": "node tools/doctor.mjs --setup",
    "prestart": "npm run build",
    "prebuild": "node tools/doctor.mjs --install"
  },
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
